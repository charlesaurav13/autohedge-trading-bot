# ============================================
# AUTOHEDGE TRADING BOT - ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to Git (it's in .gitignore)

# ============================================
# TRADING CONFIGURATION
# ============================================
TRADING_MODE=paper                      # paper or live
MIN_SIGNAL_STRENGTH=2.0                # 0-20 scale (lower = more aggressive)
POSITION_SIZE_PCT=40                    # % of capital per trade (with leverage)
LEVERAGE=10                             # Binance Futures leverage
MAX_TRADES_PER_DAY=3                   # Daily trade limit

# Risk Management
STOP_LOSS_PCT=5                        # Stop loss percentage
TAKE_PROFIT_PCT=10                     # Take profit percentage

# ============================================
# BINANCE API (Required for trading)
# ============================================
# Get from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_secret_here
BINANCE_TESTNET=false                  # Use testnet for testing

# ============================================
# AI MODELS
# ============================================

# DeepSeek API (for AutoHedge LLM)
# Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-reasoner      # or deepseek-chat

# Local Model (Alternative - FREE!)
USE_LOCAL_MODEL=true                   # Use Ollama instead of API
LOCAL_MODEL=openai/deepseek-r1:1.5b   # Ollama model name

# RL Model Integration
USE_RL_MODEL=true                      # Enable trained RL model
RL_MODEL_PATH=models/production/v1.2.0.zip
RL_INTEGRATION_MODE=hybrid             # hybrid/replace/veto/ensemble
REQUIRE_CONSENSUS=true                 # Both LLM & RL must agree

# ============================================
# NEWS SOURCES (for sentiment analysis)
# ============================================
# CryptoPanic API (optional)
CRYPTOPANIC_API_KEY=your_cryptopanic_key_here

# NewsAPI (optional)
NEWSAPI_KEY=your_newsapi_key_here

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR
LOG_FILE=bot_local_final.log
SAVE_TRADES_TO_FILE=true

# TensorBoard (for training visualization)
TENSORBOARD_PORT=6006

# ============================================
# NOTIFICATIONS (Optional)
# ============================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Discord Webhook
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Email (SMTP)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=notifications@yourdomain.com

# ============================================
# TRAINING CONFIGURATION
# ============================================

# Automated Retraining
AUTO_RETRAIN_ENABLED=false             # Enable weekly auto-retraining
AUTO_RETRAIN_SCHEDULE="0 2 * * 1"     # Cron format (Monday 2 AM)
MIN_TRADES_FOR_RETRAIN=20              # Minimum new trades needed

# Hardware
TRAINING_DEVICE=mps                    # mps (M1/M2/M4 Mac), cuda, or cpu
NUM_WORKERS=4                          # Parallel training workers

# ============================================
# ADVANCED SETTINGS
# ============================================

# Paper Trading
PAPER_TRADING_INITIAL_BALANCE=100      # Starting balance (USDT)
PAPER_TRADING_SAVE_STATE=true          # Persist state across restarts

# API Rate Limiting
BINANCE_RATE_LIMIT_PER_MINUTE=100
DEEPSEEK_RATE_LIMIT_PER_MINUTE=20

# Trading Intervals
CHECK_INTERVAL_SECONDS=900             # 15 minutes
POSITION_CHECK_INTERVAL=300            # 5 minutes

# Model Confidence Thresholds
AUTOHEDGE_MIN_CONFIDENCE=0.70
AUTOHEDGE_OVERRIDE_THRESHOLD=0.85      # High confidence can override RL

# ============================================
# DATABASE (Optional - for trade history)
# ============================================
DATABASE_URL=sqlite:///trades.db       # or postgresql://...

# ============================================
# DEVELOPMENT & TESTING
# ============================================
DEBUG_MODE=false
MOCK_TRADING_API=false                 # Mock API calls for testing
SKIP_NEWS_SENTIMENT=false              # Skip news for faster testing

# ============================================
# SECURITY
# ============================================
# Restrict IP (Binance API security)
ALLOWED_IPS=0.0.0.0/0                  # Change to your IP for production

# API Request Signing
ENABLE_API_SIGNATURE=true

# ============================================
# NOTES
# ============================================
# 1. Never commit .env to Git!
# 2. Use strong API keys
# 3. Enable IP restrictions on Binance
# 4. Start with paper trading
# 5. Test with small amounts first
# 6. Monitor closely for first 24 hours
#
# For help: https://github.com/charlesaurav13/AutoHedge/issues
